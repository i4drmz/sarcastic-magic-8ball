# Pulse remote data root (no trailing slash).
# Catalog:  ${EXPO_PUBLIC_PULSE_DATA_BASE_URL}/birthdays.json
# Events:   ${EXPO_PUBLIC_PULSE_DATA_BASE_URL}/events.json
# Images:   ${EXPO_PUBLIC_PULSE_DATA_BASE_URL}/images/<file>.webp
EXPO_PUBLIC_PULSE_DATA_BASE_URL=https://raw.githubusercontent.com/<username>/<repository>/main/data

# Events pipeline uses free public RSS feeds only (no API keys).
# Optional local dry-run without git push:
# PULSE_SKIP_PUBLISH=1
